{
  "version": "1.0",
  "conventions": {
    "name": "surface.object_action (snake)",
    "verbs": [
      "view",
      "start",
      "complete",
      "click",
      "flip",
      "select",
      "toggle",
      "submit",
      "copy",
      "save",
      "share",
      "dismiss",
      "scroll",
      "drag",
      "skip",
      "error"
    ],
    "surfaces": [
      "app",
      "landing",
      "test",
      "person",
      "match",
      "share"
    ]
  },
  "enums": {
    "via": [
      "kakao",
      "x",
      "instagram",
      "link",
      "image",
      "other"
    ],
    "surface": [
      "person",
      "match"
    ],
    "face": [
      "front",
      "back"
    ],
    "method": [
      "input",
      "quiz"
    ],
    "grade": [
      "S",
      "A",
      "B",
      "C"
    ],
    "beat": [
      "summon",
      "reaction",
      "verdict"
    ],
    "axis": [
      "perceiving",
      "judging"
    ],
    "bucket": [
      "ALIGN",
      "KIN",
      "CONTRAST",
      "COMPLEMENT"
    ],
    "cta": [
      "start_test",
      "pick_type",
      "see_example"
    ],
    "dichotomy": [
      "EI",
      "SN",
      "TF",
      "JP"
    ]
  },
  "envelope": {
    "event": "string",
    "ts": "epoch_ms",
    "anon_id": "uuid(localStorage)",
    "session_id": "uuid(30min idle reset)",
    "route": "string",
    "type_self": "MBTI|null",
    "seq": "int(session-local order)",
    "props": "object"
  },
  "events": {
    "app.session_start": {
      "when": "첫 렌더",
      "props": [
        "ref",
        "src",
        "via",
        "sid",
        "referrer",
        "device"
      ]
    },
    "app.route_change": {
      "when": "라우트 전환",
      "props": [
        "from",
        "to"
      ]
    },
    "app.scroll_depth": {
      "when": "25/50/75/100% 각 1회",
      "props": [
        "route",
        "pct"
      ],
      "dedupe": "threshold-once"
    },
    "app.session_end": {
      "when": "이탈/beforeunload(sendBeacon)",
      "props": [
        "last_route",
        "dwell_ms"
      ]
    },
    "app.error": {
      "when": "런타임 오류",
      "props": [
        "kind",
        "msg"
      ]
    },
    "landing.view": {
      "when": "/ 진입",
      "props": [
        "ref",
        "src",
        "via",
        "sid"
      ]
    },
    "landing.cta_click": {
      "when": "메인 CTA",
      "props": [
        "cta"
      ]
    },
    "landing.type_select": {
      "when": "유형 직접 클릭",
      "props": [
        "type"
      ]
    },
    "landing.example_match_click": {
      "when": "예시 매칭",
      "props": []
    },
    "test.start": {
      "when": "검사 시작",
      "props": [
        "method"
      ]
    },
    "test.method_toggle": {
      "when": "input/quiz 전환",
      "props": [
        "to"
      ]
    },
    "test.mbti_letter_pick": {
      "when": "4지표 토글",
      "props": [
        "dichotomy",
        "value"
      ]
    },
    "test.quiz_answer": {
      "when": "문항 응답",
      "props": [
        "q_index",
        "choice",
        "elapsed_ms"
      ]
    },
    "test.quiz_back": {
      "when": "이전 문항",
      "props": [
        "from_q"
      ]
    },
    "test.submit_click": {
      "when": "제출",
      "props": []
    },
    "test.complete": {
      "when": "유형 확정",
      "props": [
        "type",
        "method",
        "duration_ms"
      ]
    },
    "test.error": {
      "when": "미완성 제출",
      "props": [
        "validation"
      ]
    },
    "test.retake_click": {
      "when": "재검사",
      "props": [
        "prev_type"
      ]
    },
    "person.view": {
      "when": "/u 렌더",
      "props": [
        "type",
        "is_owner",
        "ref",
        "src",
        "via",
        "sid"
      ]
    },
    "person.card_flip": {
      "when": "카드 전면↔후면 탭",
      "props": [
        "func",
        "pos",
        "face"
      ],
      "dedupe": "keep-all(+flip_count rollup)"
    },
    "person.tier_tooltip_open": {
      "when": "티어 툴팁",
      "props": [
        "pos"
      ]
    },
    "person.tension_expand": {
      "when": "스택 내부 긴장 펼침",
      "props": [
        "pair"
      ]
    },
    "person.pick_partner_click": {
      "when": "상대 고르기 CTA",
      "props": []
    },
    "person.partner_type_select": {
      "when": "상대 유형 선택",
      "props": [
        "b"
      ]
    },
    "person.share_click": {
      "when": "공유 버튼",
      "props": [
        "sid",
        "surface",
        "via"
      ]
    },
    "person.copy_link": {
      "when": "링크 복사",
      "props": [
        "sid"
      ]
    },
    "person.save_image": {
      "when": "이미지 저장",
      "props": [
        "sid"
      ]
    },
    "person.edit_type_click": {
      "when": "유형 재설정",
      "props": []
    },
    "match.open": {
      "when": "/match 진입",
      "props": [
        "a",
        "b",
        "ref",
        "self_initiated",
        "sid",
        "src",
        "via"
      ]
    },
    "match.reveal_start": {
      "when": "연출 시작",
      "props": [
        "a",
        "b"
      ]
    },
    "match.reveal_beat": {
      "when": "비트 진입",
      "props": [
        "beat"
      ]
    },
    "match.reaction_line_view": {
      "when": "라인 점화",
      "props": [
        "axis",
        "bucket"
      ]
    },
    "match.reveal_skip_click": {
      "when": "연출 스킵",
      "props": [
        "at_beat"
      ]
    },
    "match.score_countup_done": {
      "when": "점수 카운트업 종료",
      "props": [
        "score",
        "grade"
      ]
    },
    "match.reveal_complete": {
      "when": "판정 도달",
      "props": [
        "a",
        "b",
        "score",
        "grade",
        "watched_ms",
        "skipped"
      ],
      "dedupe": "once-per-open"
    },
    "match.card_expand": {
      "when": "판정 카드 열람",
      "props": [
        "which"
      ]
    },
    "match.person_card_click": {
      "when": "상대 카드 → 페이지",
      "props": [
        "slot",
        "type"
      ]
    },
    "match.rematch_click": {
      "when": "다른 상대 재매칭",
      "props": [
        "from_pair"
      ]
    },
    "match.swap_click": {
      "when": "A↔B 교체",
      "props": []
    },
    "match.change_partner_click": {
      "when": "상대 변경",
      "props": []
    },
    "match.partner_type_select": {
      "when": "상대 유형 선택",
      "props": [
        "b"
      ]
    },
    "match.replay_click": {
      "when": "연출 재생",
      "props": []
    },
    "match.share_click": {
      "when": "공유 버튼",
      "props": [
        "sid",
        "surface",
        "via",
        "score",
        "grade"
      ]
    },
    "match.copy_link": {
      "when": "링크 복사",
      "props": [
        "sid",
        "score"
      ]
    },
    "match.save_image": {
      "when": "OG 한컷 저장",
      "props": [
        "sid",
        "score"
      ]
    },
    "share.sheet_open": {
      "when": "공유 시트 열림",
      "props": [
        "surface",
        "sid"
      ]
    },
    "share.channel_pick": {
      "when": "채널 선택",
      "props": [
        "surface",
        "via",
        "sid"
      ]
    },
    "share.done": {
      "when": "복사/저장 확정",
      "props": [
        "surface",
        "via",
        "sid"
      ]
    },
    "share.dismiss": {
      "when": "시트 닫힘",
      "props": [
        "surface"
      ]
    },
    "share.image_render": {
      "when": "OG 이미지 생성",
      "props": [
        "ms",
        "ok"
      ]
    }
  },
  "attribution": {
    "share_url_person": "/u?t={type}&sid={share_id}&src={sharer_type}&via={via}",
    "share_url_match": "/match?a={a}&b={b}&sid={share_id}&src={sharer_type}&via={via}",
    "join": "share_click.sid  ==  landing.view.ref  → 추천 그래프 1엣지 → K(바이럴계수)",
    "sid_lifecycle": "공유 액션당 1개 발급, URL 삽입, 수신 세션이 ref로 회수"
  },
  "hygiene": {
    "double_fire": "동일 클릭 300ms 내 중복 제거 (card_flip 제외)",
    "reveal_idempotent": "reveal_complete는 open당 1회; 재시청은 replay_click",
    "intent_vs_done": "share_click(의도)와 share.done(확정) 모두 기록",
    "transport": "핵심 4종(session_start·test_complete·reveal_complete·share_click)은 sendBeacon 보장",
    "pii": "유형·닉네임만. IP·정밀위치 미수집. anon_id는 랜덤 UUID"
  },
  "implemented": {
    "landing_view": "/ 진입(오너 없음, src·sid=유입 채널)",
    "session_start": "앱 로드(returning,src,sid)",
    "test_start": "테스트 시작",
    "quiz_answer": "문항 응답(q,v) — 문항별 이탈 측정",
    "test_complete": "유형 확정(type)",
    "direct_pick": "토글로 바로 선택(type)",
    "card_view": "카드 진입(mbti,tested)",
    "nudge_test_click": "맛보기→정밀 테스트 유도 클릭",
    "map_view": "관계 지도 진입(n)",
    "connection_open": "인연 상세 열람(mbti,chemi)",
    "explain_open": "이해·보완·긴장·자율 설명 펼침",
    "connection_delete": "인연 지우기",
    "add_view": "게스트 합류 화면 진입(owner,src,sid)",
    "add_submit": "게스트 합류 제출(mbti,chemi) — 핵심 전환",
    "guest_make_own": "게스트→본인 지도 만들기(바이럴 전환)",
    "share_click": "링크복사 클릭=발신(surface,sid)",
    "share_done": "링크복사 완료=진짜 공유수(surface,sid)",
    "prompt_copy": "상세 분석 프롬프트 복사(surface,mbti)"
  },
  "analytics": {
    "amplitude": "제품 분석",
    "ga4": "GA4 gtag 동시 전송",
    "warehouse": "GA4→BigQuery 네이티브 export"
  }
}